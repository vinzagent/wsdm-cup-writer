# xAI API key for Grok: https://console.x.ai
XAI_API_KEY=

# Keep true until X admits your writer, then set to false to submit live notes
TEST_MODE=true

# Max notes submitted per day by this writer. New writers start at 10/day
# on the X API side; raise as the CRH rate grows, never above 65
# (the competition cap).
DAILY_NOTE_LIMIT=10

# Model used for research + drafting. Any model allowed; Grok is the
# default because the competition provides X + Grok credits.
LLM_MODEL=grok-4.3
